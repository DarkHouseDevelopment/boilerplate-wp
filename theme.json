	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0px"
				},
				"outline": {
					"width": "2px",
					"style": "solid",
					"offset": "-2px"
				},
				"spacing": {
					"padding": {
						"top": "10px",
						"right": "30px",
						"bottom": "10px",
						"left": "30px"
					}
				},
				"variations": {
					"outline": {
						"spacing": {
							"padding": {
								"top": "10px",
								"right": "30px",
								"bottom": "10px",
								"left": "30px"
							}
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"margin": {
						"top": "40px"
					}
				}
			},
			"core/columns": {
				"spacing": {
					"margin": {
						"bottom": "20px"
					}
				}
			},
			"core/image": {
				"spacing": {
					"margin": {
						"bottom": "20px"
					}
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--primary)"
				},
				"dimensions": {
					"minHeight": "2px"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--large)",
						"top": "var(--wp--preset--spacing--large)"
					}
				}
			}
		},
		"color": {
			"text": "var(--wp--preset--color--darker-grey)"
		},
		"elements": {
			"button": {
				"typography": {
					"fontFamily": "'proxima-nova',Helvetica,Arial,sans-serif",
					"fontStyle": "normal",
					"fontWeight": "600",
					"letterSpacing": "1px",
					"lineHeight": "1.75"
				}
			},
			"h1": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--large)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "clamp(1.5rem, 1.429vw + 1.143rem, 2rem)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"h5": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--small)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"textTransform": "none"
				}
			},
			"h6": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--small)"
					}
				},
				"typography": {
					"fontSize": "20px",
					"fontStyle": "normal",
					"fontWeight": "400",
					"textTransform": "uppercase"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--medium)",
						"top": "var(--wp--preset--spacing--small)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mina)",
					"fontStyle": "normal",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"textTransform": "uppercase"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--warm-black)"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"typography": {
			"fontFamily": "'adriane',Helvetica,Arial,sans-serif",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5"
		}
	},
	"version": 3,
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json"
}